{
    "name": "fang",
    "displayName": "Fang - Vyper Language Support",
    "description": "Comprehensive language support for Vyper smart contracts. Features syntax highlighting, code decorations, hover documentation, Language Server Protocol (LSP) integration, and code snippets to enhance your Vyper development experience.",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": [
        "vyper",
        "ethereum",
        "blockchain",
        "smart-contracts",
        "solidity-alternative",
        "language-server",
        "lsp",
        "syntax-highlighting",
        "code-completion",
        "vyperlang"
    ],
    "publisher": "enochakinbode",
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#EDE5D5",
        "theme": "light"
    },
    "engines": {
        "vscode": "^1.87.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "homepage": "https://github.com/enochakinbode/fang#readme",
    "bugs": {
        "url": "https://github.com/enochakinbode/fang/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/enochakinbode/fang.git"
    },
    "main": "./src/extension.js",
    "browser": "./dist/web/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "vyper",
                "aliases": [
                    "Vyper",
                    "vyper",
                    "vy"
                ],
                "extensions": [
                    ".vy",
                    ".vyi"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "images/icon_small_with_border.png",
                    "dark": "images/icon_small_with_border.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "vyper",
                "scopeName": "source.vyper",
                "path": "./syntaxes/vyper.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "vyper",
                "path": "./snippets/vyper.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Vyper (Ethereum)",
            "properties": {
                "vyper.lsp.serverCommand": {
                    "type": "string",
                    "default": "vyper-lsp",
                    "description": "Command to start the Vyper language server"
                },
                "vyper.lsp.serverArgs": {
                    "type": "array",
                    "default": [],
                    "description": "Arguments to pass to the language server"
                },
                "vyper.lsp.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable the language server"
                },
                "vyper.customTheme": {
                    "type": "string",
                    "default": "",
                    "description": "Custom theme file name (without .json extension) from the themes folder. Leave empty to use default theme. Example: 'pythonic-vyper-color-theme' will load themes/pythonic-vyper-color-theme.json"
                },
                "vyper.customThemeEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable custom theme support. When enabled, loads the theme specified in 'vyper.customTheme' setting."
                }
            }
        },
        "commands": [
            {
                "command": "vyper.restartLspServer",
                "title": "Restart Vyper LSP Server",
                "category": "Vyper"
            }
        ]
    },
    "scripts": {
        "combineSnippets": "cat snippets/expr_builtins.json snippets/stmt_builtins.json snippets/expressions.json snippets/statements.json snippets/module.json snippets/other.json snippets/types.json | jq -s 'reduce .[] as $item ({}; .[\".source.vyper\"] += $item[\".source.vyper\"])' > snippets/vyper.json",
        "generateGrammar": "rm -f syntaxes/vyper.tmLanguage.json && python3 scripts/generate_vyper_grammar.py > syntaxes/vyper.tmLanguage.json",
        "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
        "pretest": "bun run compile-web",
        "vscode:prepublish": "bun install && bun run package-web",
        "compile-web": "webpack -c config/web.webpack.config.js",
        "watch-web": "webpack -c config/web.webpack.config.js --watch",
        "package-web": "webpack -c config/web.webpack.config.js --mode production --devtool hidden-source-map",
        "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.0"
    },
    "devDependencies": {
        "@vscode/test-web": "^0.0.52",
        "webpack": "^5.66.0",
        "webpack-cli": "^4.9.1"
    }
}